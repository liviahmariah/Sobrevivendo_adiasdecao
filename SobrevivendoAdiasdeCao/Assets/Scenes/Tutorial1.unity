  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialFugaManager
  etapaAtual: 0
  painelDialogo: {fileID: 129194749}
  textoDuke: {fileID: 2102600368}
  tituloFase: {fileID: 501726592}
  textoTitulo: {fileID: 501726594}
  objetivo: {fileID: 0}
  textoObjetivo: {fileID: 120947667}
  tutorialTimer: {fileID: 1614496688}
  chefe: {fileID: 174673931}
  tempoEntreFalase: 2
  tempoParaDica: 8
  tempoExibicaoFala: 3.5
  falasIntroducao:
  - "As coisas n\xE3o est\xE3o boas para n\xF3s..."
  - Precisamos fugir deste lugar!
  - "Sandy, voc\xEA conseguiu sair da sua gaiola. Ajude os outros a sa\xEDrem tamb\xE9m!"
  - "O chefe da carrocinha est\xE1 no hor\xE1rio de intervalo agora. \xC9 a nossa
    chance!"
  - "Mas o intervalo n\xE3o vai durar para sempre. Quando ele voltar, vai come\xE7ar
    a ronda pelas gaiolas."
  - Precisamos libertar todos antes que ele termine a ronda!
  - "Voc\xEA precisa coletar as 9 chaves das gaiolas. R\xE1pido, estamos quase sem
    tempo!"
